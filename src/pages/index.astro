---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = articles[0];
const rest = articles.slice(1);

const columnLabel: Record<string, string> = {
  news: 'News',
  'government-affairs': 'Government affairs',
  verified: 'Verified',
};
---
<BaseLayout title="Home">
  {featured && (
    <a href={`/articles/${featured.slug}`} class="card" style="display:block; margin-bottom: 1.5rem; text-decoration:none;">
      <span class="eyebrow">{columnLabel[featured.data.column]}</span>
      <h1 style="margin-top: 0.5rem;">{featured.data.title}</h1>
      {featured.data.dek && <p style="color: var(--color-ink); opacity: 0.65;">{featured.data.dek}</p>}
    </a>
  )}

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
    {rest.map((article) => (
      <a href={`/articles/${article.slug}`} class="card" style="text-decoration:none;">
        <span class="eyebrow">{columnLabel[article.data.column]}</span>
        <h3 style="margin-top: 0.5rem;">{article.data.title}</h3>
      </a>
    ))}
  </div>
</BaseLayout>
