---
import OrganizationSchema from '../components/seo/OrganizationSchema.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  tags?: string[];
}
const { title, description = 'Verified news and government affairs reporting from SRDG Intel.', image, tags = [] } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image ?? '/logo.svg', Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light" />
  <title>{title} · SRDG Intel</title>
  <meta name="description" content={description} />
  {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
  <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title="SRDG Intel" href="/rss.xml" />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={socialImage} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImage} />

  <OrganizationSchema />
</head>
<body>
  <header class="masthead">
    <div class="container" style="display:flex; align-items:center; justify-content:space-between; padding: 0.75rem 1.25rem;">
      <a href="/" style="color:#fff; display:flex; align-items:center; gap:8px; font-family: var(--font-ui); font-weight:600; font-size:1.1rem; letter-spacing:0.5px;">
        <svg width="24" height="24" viewBox="0 0 100 100" aria-hidden="true">
          <polygon points="50,6 92,22 92,50 92,74 74,90 50,96 26,90 8,74 8,50 8,22" fill="#ffffff" opacity="0.12"/>
          <polyline points="30,50 44,64 72,32" fill="none" stroke="#A9740A" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        SRDG INTEL
      </a>
      <nav>
        <a href="/columns/news">News</a>
        <a href="/columns/government-affairs">Government affairs</a>
        <a href="/columns/verified" style="color: var(--color-verified) !important;">Verified</a>
      </nav>
    </div>
  </header>
  <main class="container" style="padding: 2rem 1.25rem;">
    <slot />
  </main>
</body>
</html>
