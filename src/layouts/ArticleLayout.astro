---
import BaseLayout from './BaseLayout.astro';
import NewsArticleSchema from '../components/seo/NewsArticleSchema.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import FAQSchema from '../components/seo/FAQSchema.astro';

interface FaqItem { question: string; answer: string; }
interface Props {
  title: string;
  dek?: string;
  column: string;
  author: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  verified: boolean;
  slug: string;
  faq?: FaqItem[];
  tags?: string[];
}
const { title, dek, column, author, pubDate, updatedDate, heroImage, verified, slug, faq = [], tags = [] } = Astro.props;

const columnLabel: Record<string, string> = {
  news: 'News',
  'government-affairs': 'Government affairs',
  verified: 'Verified',
};
---
<BaseLayout title={title} description={dek} image={heroImage} tags={tags}>
  <NewsArticleSchema title={title} dek={dek} author={author} pubDate={pubDate} updatedDate={updatedDate} heroImage={heroImage} slug={slug} />
  <BreadcrumbSchema crumbs={[
    { name: 'Home', path: '/' },
    { name: columnLabel[column] ?? column, path: `/columns/${column}` },
    { name: title, path: `/articles/${slug}` },
  ]} />
  {faq.length > 0 && <FAQSchema faq={faq} />}

  <article>
    {verified && <span class="eyebrow">Fact-checked</span>}
    <h1>{title}</h1>
    {dek && <p style="font-family: var(--font-ui); color: var(--color-ink); opacity: 0.65;">{dek}</p>}
    <p style="font-family: var(--font-ui); font-size: 0.8rem; opacity: 0.55;">
      By {author} · {pubDate.toDateString()}
    </p>

    <div class="content">
      <slot />
    </div>

    <div style="display:flex; gap:0.75rem; margin: 1.5rem 0; font-family: var(--font-ui);">
      <button id="share-btn" style="background:var(--color-ink); color:#fff; border:none; padding:8px 16px; border-radius:6px; font-size:0.85rem; cursor:pointer;">
        Share
      </button>
    </div>
    <script define:vars={{ pageTitle: title }}>
      const btn = document.getElementById('share-btn');
      btn?.addEventListener('click', async () => {
        const shareData = { title: pageTitle, url: window.location.href };
        if (navigator.share) {
          try { await navigator.share(shareData); } catch (e) {}
        } else {
          await navigator.clipboard.writeText(window.location.href);
          btn.textContent = 'Link copied';
          setTimeout(() => (btn.textContent = 'Share'), 1500);
        }
      });
    </script>

    {faq.length > 0 && (
      <section style="margin-top: 3rem;">
        <h2>Frequently asked</h2>
        {faq.map((item) => (
          <div class="card" style="margin-bottom: 0.75rem;">
            <strong>{item.question}</strong>
            <p style="margin: 0.5rem 0 0;">{item.answer}</p>
          </div>
        ))}
      </section>
    )}

    <section style="margin-top: 3rem; font-family: var(--font-ui);">
      <h2>Comments</h2>
      <div id="comment-list" style="display:flex; flex-direction:column; gap:0.75rem; margin-bottom:1.5rem;">
        <p style="opacity:0.5; font-size:0.85rem;">Loading comments…</p>
      </div>

      <form id="comment-form" style="display:flex; flex-direction:column; gap:0.5rem;">
        <input type="text" name="website" style="position:absolute; left:-9999px;" tabindex="-1" autocomplete="off" />
        <input type="text" name="name" placeholder="Name" required maxlength="80"
          style="padding:10px; border:1px solid var(--color-border); border-radius:6px; font-family:inherit;" />
        <textarea name="body" placeholder="Add a comment" required maxlength="2000" rows="3"
          style="padding:10px; border:1px solid var(--color-border); border-radius:6px; font-family:inherit; resize:vertical;"></textarea>
        <button type="submit" style="align-self:flex-start; background:var(--color-verified); color:#fff; border:none; padding:8px 18px; border-radius:6px; font-size:0.85rem; cursor:pointer;">
          Post comment
        </button>
        <p id="comment-status" style="font-size:0.8rem; opacity:0.6; margin:0;"></p>
      </form>
    </section>

    <script define:vars={{ slug }}>
      const listEl = document.getElementById('comment-list');
      const formEl = document.getElementById('comment-form');
      const statusEl = document.getElementById('comment-status');

      function renderComments(comments) {
        if (!comments.length) {
          listEl.innerHTML = '<p style="opacity:0.5; font-size:0.85rem;">No comments yet — be the first.</p>';
          return;
        }
        listEl.innerHTML = comments.map((c) => `
          <div class="card">
            <strong>${escapeHtml(c.name)}</strong>
            <p style="margin:0.35rem 0 0; white-space:pre-wrap;">${escapeHtml(c.body)}</p>
            <p style="margin:0.35rem 0 0; font-size:0.75rem; opacity:0.5;">${new Date(c.created_at).toLocaleDateString()}</p>
          </div>
        `).join('');
      }

      function escapeHtml(str) {
        const d = document.createElement('div');
        d.textContent = str;
        return d.innerHTML;
      }

      async function loadComments() {
        try {
          const res = await fetch(`/api/comments?slug=${encodeURIComponent(slug)}`);
          renderComments(await res.json());
        } catch (e) {
          listEl.innerHTML = '<p style="opacity:0.5; font-size:0.85rem;">Couldn\'t load comments.</p>';
        }
      }

      formEl?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(formEl);
        statusEl.textContent = 'Posting…';
        const res = await fetch('/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            slug,
            name: fd.get('name'),
            body: fd.get('body'),
            website: fd.get('website'),
          }),
        });
        if (res.ok) {
          formEl.reset();
          statusEl.textContent = '';
          loadComments();
        } else {
          statusEl.textContent = 'Something went wrong — try again.';
        }
      });

      loadComments();
    </script>
  </article>
</BaseLayout>
