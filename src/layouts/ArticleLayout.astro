---
import BaseLayout from './BaseLayout.astro';
import NewsArticleSchema from '../components/seo/NewsArticleSchema.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import FAQSchema from '../components/seo/FAQSchema.astro';

interface FaqItem { question: string; answer: string; }
interface Props {
  title: string;
  dek?: string;
  column: string;
  author: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  verified: boolean;
  slug: string;
  faq?: FaqItem[];
  tags?: string[];
}
const { title, dek, column, author, pubDate, updatedDate, heroImage, verified, slug, faq = [], tags = [] } = Astro.props;

const columnLabel: Record<string, string> = {
  news: 'News',
  'government-affairs': 'Government affairs',
  verified: 'Verified',
};
---
<BaseLayout title={title} description={dek} image={heroImage} tags={tags}>
  <NewsArticleSchema title={title} dek={dek} author={author} pubDate={pubDate} updatedDate={updatedDate} heroImage={heroImage} slug={slug} />
  <BreadcrumbSchema crumbs={[
    { name: 'Home', path: '/' },
    { name: columnLabel[column] ?? column, path: `/columns/${column}` },
    { name: title, path: `/articles/${slug}` },
  ]} />
  {faq.length > 0 && <FAQSchema faq={faq} />}

  <article>
    {verified && <span class="eyebrow">Fact-checked</span>}
    <h1>{title}</h1>
    {dek && <p style="font-family: var(--font-ui); color: var(--color-ink); opacity: 0.65;">{dek}</p>}
    <p style="font-family: var(--font-ui); font-size: 0.8rem; opacity: 0.55;">
      By {author} · {pubDate.toDateString()}
    </p>

    <div class="content">
      <slot />
    </div>

    <div style="display:flex; gap:0.75rem; margin: 1.5rem 0; font-family: var(--font-ui);">
      <button id="share-btn" style="background:var(--color-ink); color:#fff; border:none; padding:8px 16px; border-radius:6px; font-size:0.85rem; cursor:pointer;">
        Share
      </button>
    </div>
    <script define:vars={{ pageTitle: title }}>
      const btn = document.getElementById('share-btn');
      btn?.addEventListener('click', async () => {
        const shareData = { title: pageTitle, url: window.location.href };
        if (navigator.share) {
          try { await navigator.share(shareData); } catch (e) {}
        } else {
          await navigator.clipboard.writeText(window.location.href);
          btn.textContent = 'Link copied';
          setTimeout(() => (btn.textContent = 'Share'), 1500);
        }
      });
    </script>

    {faq.length > 0 && (
      <section style="margin-top: 3rem;">
        <h2>Frequently asked</h2>
        {faq.map((item) => (
          <div class="card" style="margin-bottom: 0.75rem;">
            <strong>{item.question}</strong>
            <p style="margin: 0.5rem 0 0;">{item.answer}</p>
          </div>
        ))}
      </section>
    )}

    <section style="margin-top: 3rem;">
      <h2>Comments</h2>
      <script
        src="https://giscus.app/client.js"
        data-repo="Amirarlite/Srdgintel-verify-blog"
        data-repo-id="PASTE_FROM_GISCUS_APP"
        data-category="Comments"
        data-category-id="PASTE_FROM_GISCUS_APP"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="light"
        data-lang="en"
        crossorigin="anonymous"
        async
      ></script>
    </section>
  </article>
</BaseLayout>
